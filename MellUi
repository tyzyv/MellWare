            cancelTween(knob, "Position")
            switch.BackgroundColor3 = switchColor
            knob.Position = knobPosition
        end
    end

    local hit = create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Parent = row,
    })
    track(window, hit.MouseButton1Click:Connect(function()
        state = not state
        render(state, true)
        safeCall(options.Callback, state)
    end))

    local api = {}
    function api:Get()
        return state
    end
    function api:Set(value)
        state = value == true
        render(state, true)
        safeCall(options.Callback, state)
    end
    return api
end

function TabClass:CreateSlider(options)
    options = options or {}
    local window = self.window
    local minimum = tonumber(options.Min) or 0
    local maximum = tonumber(options.Max) or 100
    if maximum < minimum then
        minimum, maximum = maximum, minimum
    end
    local decimals = math.max(0, math.floor(tonumber(options.Decimals) or 0))
    local value = roundTo(clamp(tonumber(options.Default) or minimum, minimum, maximum), decimals)

    local row = createRow(self, 56)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 8),
        Size = UDim2.new(1, -110, 0, 18),
        Text = tostring(options.Name or "Slider"),
        Font = FONT_MEDIUM,
        TextSize = 13,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    local valueLabel = create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -12, 0, 8),
        Size = UDim2.fromOffset(90, 18),
        Text = "",
        Font = FONT_SEMI,
        TextSize = 13,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })
    local bar = create("Frame", {
        Position = UDim2.new(0, 12, 1, -18),
        Size = UDim2.new(1, -24, 0, 6),
        BackgroundColor3 = THEME.Off,
        BorderSizePixel = 0,
        Parent = row,
    })
    addCorner(bar, 3)
    local fill = create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = THEME.Accent,
        BorderSizePixel = 0,
        Parent = bar,
    })
    addCorner(fill, 3)
    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = THEME.Text,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = bar,
    })
    addCorner(knob, 6)
    local hit = create("TextButton", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        ZIndex = 3,
        Parent = bar,
    })

    local function render()
        local ratio = 0
        if maximum ~= minimum then
            ratio = (value - minimum) / (maximum - minimum)
        end
        fill.Size = UDim2.fromScale(ratio, 1)
        knob.Position = UDim2.fromScale(ratio, 0.5)
        valueLabel.Text = string.format("%." .. decimals .. "f", value)
    end

    local function setValue(newValue, fire)
        local numeric = tonumber(newValue) or minimum
        local rounded = roundTo(clamp(numeric, minimum, maximum), decimals)
        local changed = rounded ~= value
        value = rounded
        render()
        if fire and changed then
            safeCall(options.Callback, value)
        end
    end

    local function valueFromX(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then
            return value
        end
        local ratio = clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
        return minimum + ratio * (maximum - minimum)
    end

    local sliding = false
    local slideMove = nil
    local slideEnd = nil

    local function stopSlide()
        sliding = false
        if slideMove then
            slideMove:Disconnect()
            slideMove = nil
        end
        if slideEnd then
            slideEnd:Disconnect()
            slideEnd = nil
        end
    end

    track(window, { Disconnect = function() stopSlide() end })

    track(window, hit.InputBegan:Connect(function(input)
        if window.destroyed or not isPointerButton(input.UserInputType) then
            return
        end
        stopSlide()
        sliding = true
        setValue(valueFromX(input.Position.X), true)
        slideMove = UserInputService.InputChanged:Connect(function(changed)
            if not sliding or window.destroyed then
                return
            end
            if isPointerMove(changed.UserInputType) then
                setValue(valueFromX(changed.Position.X), true)
            end
        end)
        slideEnd = UserInputService.InputEnded:Connect(function(ended)
            if isPointerButton(ended.UserInputType) then
                stopSlide()
            end
        end)
    end))

    render()

    local api = {}
    function api:Get()
        return value
    end
    function api:Set(newValue)
        setValue(newValue, true)
    end
    return api
end

