        BackgroundColor3 = THEME.Element,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "Get Key",
        Font = FONT_MEDIUM,
        TextSize = 14,
        TextColor3 = THEME.Text,
        Parent = root,
    })
    addCorner(keyLinkButton, CORNER_ELEMENT)
    addStroke(keyLinkButton, THEME.Border, 0.4)

    local function setStatus(text, color)
        status.Text = text
        status.TextColor3 = color
    end

    local function submitKey()
        if window.destroyed or window.keyPassed then
            return
        end
        if type(window.keyValue) ~= "string" or window.keyValue == "" then
            setStatus("Key is not configured by the script author.", THEME.Error)
            return
        end
        local entered = string.match(box.Text, "^%s*(.-)%s*$") or ""
        if entered == window.keyValue then
            window.keyPassed = true
            setStatus("Key accepted", THEME.Success)
            task.delay(0.6, function()
                unlockMain(window)
            end)
        else
            setStatus("Invalid key. Try again.", THEME.Error)
        end
    end

    local function openKeyLink()
        if type(window.getKeyUrl) ~= "string" or window.getKeyUrl == "" then
            setStatus("No key link is configured.", THEME.SubText)
            return
        end
        local ok = pcall(function()
            GuiService:OpenBrowserWindow(window.getKeyUrl)
        end)
        if ok then
            setStatus("Trying to open the key link...", THEME.SubText)
        else
            setStatus("Open this link manually: " .. window.getKeyUrl, THEME.SubText)
        end
    end

    track(window, checkButton.MouseButton1Click:Connect(submitKey))
    track(window, keyLinkButton.MouseButton1Click:Connect(openKeyLink))
    track(window, box.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            submitKey()
        end
    end))
end

