function WindowClass:ToggleMinimize()
    if self.destroyed then
        return
    end
    self.minimized = not self.minimized
    if self.minimized and self.activeDropdownClose then
        self.activeDropdownClose()
    end

    local targetHeight = self.minimized and TITLE_HEIGHT or WINDOW_HEIGHT
    if self.minimized then
        self.body.Visible = false
    else
        self.body.Visible = true
    end

    local extra = 0
    if self.minimized then
        extra = (WINDOW_HEIGHT - TITLE_HEIGHT) / 2 * self.scale
    end

    tween(self.root, MINIMIZE_TIME, {
        Size = UDim2.fromOffset(WINDOW_WIDTH, targetHeight),
    })
    tween(self.holder, MINIMIZE_TIME, {
        Position = UDim2.new(0.5, self.offsetX, 0.5, TOP_BAND / 2 + self.offsetY + extra),
    })
    self.minimizeButton.Text = self.minimized and "+" or "-"
end

function WindowClass:Destroy()
    if self.destroyed then
        return
    end
    self.destroyed = true
    if self.cameraConnection then
        self.cameraConnection:Disconnect()
        self.cameraConnection = nil
    end
    disconnectAll(self)
    self.activeDropdownClose = nil
    if self.gui then
        self.gui:Destroy()
        self.gui = nil
    end
    if MellWare._active == self then
        MellWare._active = nil
    end
end

