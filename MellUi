local function bindMinimizeButton(window)
    local button = window.minimizeButton
    track(window, button.MouseEnter:Connect(function()
        tween(button, 0.15, { BackgroundColor3 = THEME.ElementHover })
    end))
    track(window, button.MouseLeave:Connect(function()
        tween(button, 0.15, { BackgroundColor3 = THEME.Element })
    end))
    track(window, button.MouseButton1Click:Connect(function()
        window:ToggleMinimize()
    end))
end

function MellWare:CreateWindow(options)
    options = options or {}

    if MellWare._active then
        MellWare._active:Destroy()
    end

    local gui = create("ScreenGui", {
        Name = "MellWare",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 1000,
        Parent = getGuiParent(),
    })

    local window = setmetatable({}, WindowClass)
    window.gui = gui
    window.title = tostring(options.Title or "MellWare")
    window.connections = {}
    window.tabs = {}
    window.activeTab = nil
    window.offsetX = 0
    window.offsetY = 0
    window.scale = 1
    window.minimized = false
    window.destroyed = false
    window.activeDropdownClose = nil
    window.keySystem = options.KeySystem == true
    window.keyValue = options.Key ~= nil and tostring(options.Key) or nil
    window.getKeyUrl = options.GetKeyUrl
    window.keyPassed = false
    window.unlocked = not window.keySystem

    buildMainWindow(window)
    buildWatermark(window)
    if window.keySystem then
        buildKeyWindow(window)
    end

    bindDrag(window)
    bindMinimizeButton(window)
    bindViewport(window)

    MellWare._active = window
    return window
end

function WindowClass:SetTitle(name)
    if self.destroyed then
        return
    end
    self.pageTitle.Text = tostring(name)
end

function WindowClass:SelectTab(name)
    if self.destroyed then
        return false
    end
    local target = nil
    for _, tab in ipairs(self.tabs) do
        if tab.name == name then
            target = tab
            break
        end
    end
    if not target then
        return false
    end

    if self.activeDropdownClose then
        self.activeDropdownClose()
    end

    self.activeTab = target
    for _, tab in ipairs(self.tabs) do
        local active = tab == target
        tab.page.Visible = active
        tab.indicator.Visible = active
        tween(tab.button, 0.18, {
            BackgroundTransparency = active and 0 or 1,
            BackgroundColor3 = active and THEME.AccentDark or THEME.Sidebar,
        })
        tween(tab.iconObject, 0.18, {
            [tab.iconProperty] = active and THEME.Text or THEME.SubText,
        })
    end

    self.pageTitle.Text = target.name
    self.breadcrumb.Text = self.title .. " / " .. target.name
    return true
end

