local function unlockMain(window)
    if window.destroyed then
        return
    end
    window.unlocked = true
    if window.keyHolder then
        window.keyHolder:Destroy()
        window.keyHolder = nil
        window.keyScale = nil
    end
    window.holder.Visible = true
    window.watermark.Visible = true
    relayout(window)
end

