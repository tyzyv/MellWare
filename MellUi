local tweenRegistry = setmetatable({}, { __mode = "k" })

local function cancelTween(object, property)
    local registry = tweenRegistry[object]
    if registry and registry[property] then
        registry[property]:Cancel()
        registry[property] = nil
    end
end

local function tween(object, duration, properties, easingStyle)
    local registry = tweenRegistry[object]
    if not registry then
        registry = {}
        tweenRegistry[object] = registry
    end
    for property in pairs(properties) do
        cancelTween(object, property)
    end
    local info = TweenInfo.new(duration, easingStyle or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local playing = TweenService:Create(object, info, properties)
    for property in pairs(properties) do
        registry[property] = playing
    end
    playing:Play()
    return playing
end

local function create(className, properties)
    local instance = Instance.new(className)
    local parent = nil
    for key, value in pairs(properties) do
        if key == "Parent" then
            parent = value
        else
            instance[key] = value
        end
    end
    if parent then
        instance.Parent = parent
    end
    return instance
end

local function addCorner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function addStroke(parent, color, transparency)
    return create("UIStroke", {
        Color = color or THEME.Border,
        Thickness = 1,
        Transparency = transparency or 0.3,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function clamp(value, minimum, maximum)
    return math.max(minimum, math.min(maximum, value))
end

local function roundTo(value, decimals)
    local multiplier = 10 ^ decimals
    return math.floor(value * multiplier + 0.5) / multiplier
end

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return
    end
    local ok, err = pcall(callback, ...)
    if not ok then
        warn("[MellWare] Callback error: " .. tostring(err))
    end
end

local function copyList(source)
    local result = {}
    if type(source) == "table" then
        for _, value in ipairs(source) do
            table.insert(result, value)
        end
    end
    return result
end

local function isPointerButton(kind)
    return kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch
end

local function isPointerMove(kind)
    return kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch
end

local function track(owner, connection)
    table.insert(owner.connections, connection)
    return connection
end

local function disconnectAll(owner)
    for index = #owner.connections, 1, -1 do
        local connection = owner.connections[index]
        owner.connections[index] = nil
        connection:Disconnect()
    end
end

local function getGuiParent()
    local ok, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if ok and coreGui then
        local probe = Instance.new("ScreenGui")
        local parented = pcall(function()
            probe.Parent = coreGui
        end)
        probe:Destroy()
        if parented then
            return coreGui
        end
    end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function getAreaSize(gui)
    local size = gui.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then
        local camera = Workspace.CurrentCamera
        if camera then
            size = camera.ViewportSize
        else
            size = Vector2.new(WINDOW_WIDTH, WINDOW_HEIGHT)
        end
    end
    return size
end

local function computeScale(areaSize, baseWidth, baseHeight, topBand)
    local availableWidth = areaSize.X - SCREEN_MARGIN * 2
    local availableHeight = areaSize.Y - topBand - SCREEN_MARGIN * 2
    local scale = math.min(availableWidth / baseWidth, availableHeight / baseHeight, 1)
    return math.max(scale, MIN_SCALE)
end

local function createCenteredRoot(gui, width, height, holderPosition)
    local holder = create("Frame", {
        Name = "Holder",
        Size = UDim2.fromOffset(0, 0),
        Position = holderPosition,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = gui,
    })
    local root = create("Frame", {
        Name = "Root",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = THEME.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = holder,
    })
    addCorner(root, CORNER_WINDOW)
    addStroke(root, THEME.Border, 0.2)
    local scale = create("UIScale", { Scale = 1, Parent = root })
    return holder, root, scale
end

local function clampOffsets(window)
    local area = getAreaSize(window.gui)
    local limitX = math.max(0, area.X / 2 - 40)
    local limitY = math.max(0, area.Y / 2 - 40)
    window.offsetX = clamp(window.offsetX, -limitX, limitX)
    window.offsetY = clamp(window.offsetY, -limitY, limitY)
end

local function applyPosition(window)
    cancelTween(window.holder, "Position")
    local extra = 0
    if window.minimized then
        extra = (WINDOW_HEIGHT - TITLE_HEIGHT) / 2 * window.scale
    end
    window.holder.Position = UDim2.new(0.5, window.offsetX, 0.5, TOP_BAND / 2 + window.offsetY + extra)
end

local function relayout(window)
    if window.destroyed then
        return
    end
    local area = getAreaSize(window.gui)
    window.scale = computeScale(area, WINDOW_WIDTH, WINDOW_HEIGHT, TOP_BAND)
    window.rootScale.Scale = window.scale
    if window.keyScale then
        window.keyScale.Scale = computeScale(area, KEY_WIDTH, KEY_HEIGHT, 0)
    end
    window.watermarkScale.Scale = clamp((area.X - 16) / WATERMARK_WIDTH, MIN_WATERMARK_SCALE, 1)
    clampOffsets(window)
    applyPosition(window)
end

local function bindViewport(window)
    local function connectCamera()
        if window.cameraConnection then
            window.cameraConnection:Disconnect()
            window.cameraConnection = nil
        end
        local camera = Workspace.CurrentCamera
        if camera then
            window.cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                relayout(window)
            end)
        end
        relayout(window)
    end
    connectCamera()
    track(window, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(connectCamera))
    track(window, window.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        relayout(window)
    end))
end

local function bindDrag(window)
    local dragConnections = nil

    local function stopDrag()
        if dragConnections then
            for _, connection in ipairs(dragConnections) do
                connection:Disconnect()
            end
            dragConnections = nil
        end
    end

    track(window, { Disconnect = function() stopDrag() end })

    track(window, window.titleBar.InputBegan:Connect(function(input)
        if window.destroyed or not isPointerButton(input.UserInputType) then
            return
        end
        stopDrag()
        cancelTween(window.holder, "Position")
        local startPointer = input.Position
        local startX = window.offsetX
        local startY = window.offsetY
        dragConnections = {
            UserInputService.InputChanged:Connect(function(changed)
                if window.destroyed then
                    stopDrag()
                    return
                end
                if not isPointerMove(changed.UserInputType) then
                    return
                end
                local delta = changed.Position - startPointer
                window.offsetX = startX + delta.X
                window.offsetY = startY + delta.Y
                clampOffsets(window)
                applyPosition(window)
            end),
            UserInputService.InputEnded:Connect(function(ended)
                if isPointerButton(ended.UserInputType) then
                    stopDrag()
                end
            end),
        }
    end))
end

